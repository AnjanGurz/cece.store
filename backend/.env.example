# =====================================================
#  .env.example  —  Copy to .env before running
#
#  NEVER commit your actual .env file to git.
# =====================================================

# Secret key for signing JWT tokens.
# Use a long, random string — at least 40 characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(40).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_key

# Admin password (hashed at first login — stored securely)
# Initial plain-text password. Change immediately after first login.
ADMIN_PASSWORD=cece2024

# Server port (Render will override this automatically)
PORT=3000

# Comma-separated list of allowed frontend origins.
# Add your Netlify domain here.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-site.netlify.app
